<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT"><PatternLayout pattern="%d{HH:mm:ss.SSS} %5p [%15.15t] %-30.30c{1.} : %m%n%ex"/></Console>
    </Appenders>
    <Loggers>
        <Root level="WARN"><AppenderRef ref="Console"/></Root>
        <Logger name="eu.arrowhead.workflowmanager" level="INFO"/>
    </Loggers>
</Configuration>
