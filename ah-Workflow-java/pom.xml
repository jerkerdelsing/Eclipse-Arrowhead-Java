<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath />
  </parent>
  <groupId>eu.arrowhead</groupId>
  <artifactId>arrowhead-workflow</artifactId>
  <version>5.4.0</version>
  <packaging>pom</packaging>
  <name>Arrowhead Workflow (WorkflowManager, WorkflowExecutor, WorkflowConfigurator)</name>
  <description>WorkflowManager and WorkflowExecutor support systems; coexist with the Choreographer (option A)</description>

  <modules>
    <module>workflow-model</module>
    <module>workflow-manager</module>
    <module>workflow-executor</module>
    <module>workflow-configurator</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mariadb.version>3.5.11</mariadb.version>
    <lmax.disruptor.version>4.0.0</lmax.disruptor.version>
    <!-- shared private copy of the Arrowhead common library (same snapshot as ah5-Choreographer-java-spring/vendor) -->
    <ah.vendor.dir>${maven.multiModuleProjectDirectory}/vendor</ah.vendor.dir>
  </properties>
</project>
